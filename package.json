{
  "name": "chittyair",
  "version": "2.0.0",
  "description": "ChittyAIR - AI Executive & Agent Management System with Google Workspace Integration",
  "main": "main.py",
  "type": "module",
  "scripts": {
    "discover": "node discover-and-sync.js discover",
    "sync": "node discover-and-sync.js sync",
    "validate": "node validate-config.js",
    "workspace:start": "python main.py",
    "workspace:docker": "docker build -t chittyair . && docker run -p 8080:8080 chittyair",
    "workspace:deploy": "gcloud builds submit --tag gcr.io/genie-patch-v1-0/chittyair",
    "test": "python -m pytest tests/",
    "lint": "eslint *.js"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "js-yaml": "^4.1.0",
    "fs-extra": "^11.2.0",
    "chokidar": "^3.5.3",
    "dotenv": "^17.3.1",
    "commander": "^11.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0"
  },
  "keywords": [
    "chittyair",
    "ai-executives",
    "google-workspace",
    "automation",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NeverShitty/chittyAIR.git"
  },
  "author": "ChittyOS",
  "license": "Proprietary"
}