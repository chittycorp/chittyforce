modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["libxcrypt", "openssl", "postgresql"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port 5000"]

[workflows]
runButton = "Start FastAPI"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --reuse-port --reload main:app"
waitForPort = 5000

[[workflows.workflow]]
name = "Start FastAPI"
author = 40576215
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:5000 --workers 1 --reload main:app"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true
